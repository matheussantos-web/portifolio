# Servidor
PORT=8787
NODE_ENV=development

# Origens autorizadas a chamar a API (separadas por vírgula).
# Em produção, informe a URL pública do site. Ex.: https://thapps.com.br
# Em desenvolvimento, localhost é liberado automaticamente.
CORS_ORIGIN=http://localhost:5173

# Resend — envio de e-mail transacional.
# Crie a chave em https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Precisa ser um domínio verificado no Resend.
CONTACT_FROM_EMAIL=Th Apps <contato@seudominio.com>

# Cloudflare Turnstile — proteção do formulário.
# Crie as chaves em https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# Opcional: webhook para integrar com CRM, planilha, Discord etc.
CONTACT_WEBHOOK_URL=

# Limite de solicitações por IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=6

# Número de proxies confiáveis à frente do serviço.
# Render/Vercel: 1. Com Cloudflare na frente: 2. Use "false" para desativar.
TRUST_PROXY=1

# Em desenvolvimento, as solicitações também são gravadas em server/outbox.
