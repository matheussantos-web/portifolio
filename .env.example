# ── Site ────────────────────────────────────────────────────────────────────
# URL pública do site (usada em canonical, Open Graph, sitemap e robots).
# Em produção, informe o domínio real, sem barra final. Ex.: https://thapps.com.br
VITE_SITE_URL=https://thapps.example

# ── Formulário de orçamento ─────────────────────────────────────────────────
# Endpoint do backend Node/Express.
# Desenvolvimento: http://localhost:8787/api/contact
# Produção: URL pública do serviço. Ex.: https://api.seudominio.com/api/contact
VITE_CONTACT_ENDPOINT=http://localhost:8787/api/contact

# ── Cloudflare Turnstile ────────────────────────────────────────────────────
# Chave pública do widget. Deixe vazio para desativar a verificação no front-end.
# Ao ativar aqui, configure também TURNSTILE_SECRET_KEY no backend (server/.env).
# Chaves de teste: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=
